// Curve — dev / staging. Same build as production, deployed as a separate Worker.
//
// Cloudflare Workers Builds (CI):
//   Build command:  npm ci && npm run build
//   Deploy command: npx wrangler deploy -c wrangler.dev.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curve-dev",
  "compatibility_date": "2026-11-08",

  "workers_dev": true,

  // Custom domain for dev. Uncomment and set:
  // "routes": [{ "pattern": "dev.curve.by.dai.studio", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    // Curve is one page (no client-side routes): unknown paths get public/404.html with a real
    // 404 status, so crawlers and browsers see missing files (robots.txt, favicon.ico…) as missing.
    "not_found_handling": "404-page"
  }
}
