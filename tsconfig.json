{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "types": [
      "vitest/globals",
      "svelte",
      "vite/client"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
